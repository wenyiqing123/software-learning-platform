IMAGE_TAG=replace-before-deploy
MECHA_QA_ROOT=/opt/software-learning-platform/releases/replace-before-deploy/graph

MYSQL_HOST=agent-chat-mysql
MYSQL_PORT=3306
MYSQL_DATABASE=software_learning
MYSQL_USERNAME=slp_mysql_0123456789ab
MYSQL_PASSWORD=replace-with-generated-password

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/software-learning
RABBITMQ_USERNAME=slp_rabbit_0123456789ab
RABBITMQ_PASSWORD=replace-with-generated-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=slp_redis_0123456789ab
REDIS_PASSWORD=replace-with-generated-password

JWT_SECRET=replace-with-64-byte-random-secret
JWT_EXPIRATION_MINUTES=20
NEBULA_HOST=agent-chat-nebula-graphd
NEBULA_PORT=9669
NEBULA_ACCOUNT=root
NEBULA_PASSWORD=replace-with-existing-nebula-password

OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=replace-with-your-deepseek-key
OPENAI_MODEL=deepseek-flash
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=1024
AI_MODEL_HTTP_TIMEOUT=30s
AI_STREAM_TIMEOUT=120s
PYTHON_KNOWLEDGE_URL=http://python-bridge:8999
PYTHON_GRAPH_CONNECT_TIMEOUT=3s
PYTHON_GRAPH_READ_TIMEOUT=20s
AI_SERVICE_URL=http://ai-service:8082
LEARNING_SERVICE_URL=http://learning-service:8081
RANKED_MODEL_ENABLED=false
RANKED_MODEL_BASE_URL=http://127.0.0.1:8998/v1
RANKED_MODEL_API_KEY=
RANKED_MODEL_NAME=qwen35-ranked-lora
RANKED_MODEL_TEMPERATURE=0
RANKED_MODEL_MAX_TOKENS=512
RANKED_MODEL_HTTP_TIMEOUT=90s
RANKED_MATRIX_ENABLED=false
RANKED_MATRIX_BASE_MODEL_NAME=qwen35-base
